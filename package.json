{
  "name": "codex-scope-pls",
  "displayName": "Codex Scope Pls",
  "description": "GUI-only, reversible workspace chat filtering for explicitly supported Codex builds.",
  "version": "0.3.6",
  "publisher": "local",
  "license": "AGPL-3.0-only",
  "engines": {
    "vscode": "^1.96.2"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "scripts": {
    "vscode:uninstall": "node ./src/uninstall.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "check:compatibility": "node scripts/check-codex-compatibility.js",
    "package": "node scripts/package.js"
  },
  "contributes": {
    "configuration": {
      "title": "Codex Scope Pls",
      "properties": {
        "codexScopePls.mode": {
          "type": "string",
          "enum": [
            "workspace",
            "all"
          ],
          "default": "workspace",
          "scope": "window",
          "markdownDescription": "Show chats for exact workspace roots, or show all local chats. Changes update the history display immediately. A **Workspace** value overrides the **User** default. Use **Codex Scope Pls: Use Global Mode in This Workspace** to remove that override.",
          "enumDescriptions": [
            "Show local chats whose working directory matches an active workspace root.",
            "Show local chats across project folders. Cloud visibility is controlled separately."
          ]
        },
        "codexScopePls.showCloudChats": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Display cloud chats in every workspace. Off hides them independently of local mode. Changes update the history display immediately."
        },
        "codexScopePls.groupChatsByProject": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "When Mode is all, show folder sections in the inline chat history and Chat history menu. Uses each chat's recorded working directory; changes update the display immediately."
        }
      }
    },
    "commands": [
      {
        "command": "codexScopePls.workspace",
        "title": "Use Current Workspace",
        "category": "Codex Scope Pls"
      },
      {
        "command": "codexScopePls.all",
        "title": "Show All Sessions",
        "category": "Codex Scope Pls"
      },
      {
        "command": "codexScopePls.reapply",
        "title": "Reapply Patch",
        "category": "Codex Scope Pls"
      },
      {
        "command": "codexScopePls.restore",
        "title": "Restore Original Codex Extension",
        "category": "Codex Scope Pls"
      },
      {
        "command": "codexScopePls.diagnostics",
        "title": "Show Diagnostics",
        "category": "Codex Scope Pls"
      },
      {
        "command": "codexScopePls.settings",
        "title": "Filter Settings",
        "category": "Codex Scope Pls",
        "icon": "$(settings-gear)"
      },
      {
        "command": "codexScopePls.globalSettings",
        "title": "Global Filter Settings",
        "category": "Codex Scope Pls"
      },
      {
        "command": "codexScopePls.useGlobalMode",
        "title": "Use Global Mode in This Workspace",
        "category": "Codex Scope Pls"
      },
      {
        "command": "codexScopePls.toggleCloud",
        "title": "Show Cloud Chats Everywhere",
        "category": "Codex Scope Pls",
        "toggled": "config.codexScopePls.showCloudChats"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codexScopePls.settings",
          "when": "view == chatgpt.sidebarView || view == chatgpt.sidebarSecondaryView",
          "group": "navigation@100"
        },
        {
          "command": "codexScopePls.workspace",
          "when": "view == chatgpt.sidebarView || view == chatgpt.sidebarSecondaryView",
          "group": "codexScopePls@1"
        },
        {
          "command": "codexScopePls.all",
          "when": "view == chatgpt.sidebarView || view == chatgpt.sidebarSecondaryView",
          "group": "codexScopePls@2"
        },
        {
          "command": "codexScopePls.toggleCloud",
          "when": "view == chatgpt.sidebarView || view == chatgpt.sidebarSecondaryView",
          "group": "codexScopePls@3"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/darkone0112/codex-scope-pls.git"
  }
}
